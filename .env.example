# --- PostgreSQL (compose: servicio postgres) ---
POSTGRES_USER=metamorph
POSTGRES_PASSWORD=metamorph
POSTGRES_DB=metamorph

DATABASE_URL=postgresql://metamorph:metamorph@localhost:5432/metamorph

# --- RabbitMQ (compose: servicio rabbitmq) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=metamorph.topic
# Management UI: http://localhost:15672

# --- S3 object storage (compose: Garage + CORS initialization) ---
# Development examples; generate your own values before exposing the service:
# S3_ACCESS_KEY: "GK" + 16 random hex bytes; secrets: 32 random hex bytes.
S3_ENDPOINT=http://localhost:3900
S3_ACCESS_KEY=GK0123456789abcdef0123456789abcdef
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET=metamorph-artifacts
S3_REGION=garage
GARAGE_RPC_SECRET=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
# Host interface for Docker's S3 port; use the server's Tailscale IP for remote previews.
S3_BIND_HOST=127.0.0.1

# --- API / Web ---
PORT=3001
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Browser-accessible S3 endpoint for signed artifact links (defaults to S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=http://localhost:3900

# --- Apps ---
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m3
# google/gemini-2.5-flash works with OPENROUTER_USE_JSON_SCHEMA=true, minimax/minimax-m3 no.
# Abort OpenRouter calls after this many ms
OPENROUTER_TIMEOUT_MS=30000
# Use json_schema strict mode only for models that support structured_outputs (opt-in).
OPENROUTER_USE_JSON_SCHEMA=false
# Retry successful OpenRouter responses that contain no assistant content.
OPENROUTER_EMPTY_CONTENT_MAX_RETRIES=2
OPENROUTER_EMPTY_CONTENT_RETRY_DELAY_MS=250

PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_LOCALE=es-ES
# Parallel browser jobs (discover, probe, smoke, execute_pair) — default matches four transform families
MAX_CONCURRENT_BROWSERS=4
# Parallel explore graphs (one per transform family by default)
WORKER_LLM_CONCURRENCY=4
